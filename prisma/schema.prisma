// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// A shipper you move freight for. You bill the customer for each load.
model Customer {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  loads     Load[]
}

// A trucking company you dispatch loads to. You pay the carrier for each load.
model Carrier {
  id         String   @id @default(cuid())
  name       String
  mcNumber   String? // FMCSA Motor Carrier number, used to verify a carrier is authorized to haul
  dotNumber  String? // US DOT number
  contact    String?
  phone      String?
  email      String?
  createdAt  DateTime @default(now())
  loads      Load[]
}

enum LoadStatus {
  BOOKED
  DISPATCHED // carrier assigned
  ON_ROUTE_TO_PICKUP // manual for now; will auto-set once live GPS shows the carrier ~5mi from the dispatch location
  AT_PICKUP // carrier checked in at pickup, set manually
  IN_TRANSIT // loaded and checked out of pickup with a BOL
  AT_DELIVERY // carrier checked in at the delivery site
  DELIVERED // POD received, load complete
  INVOICED
  CANCELLED
}

enum Equipment {
  SPRINTER
  SMALL_STRAIGHT
  LARGE_STRAIGHT
  DRY_VAN
  FLATBED
}

enum ModeType {
  GROUND
  OCEAN
  CROSS_BORDER
  AIR
}

// The central object of the TMS: one shipment moving from an origin to a destination.
model Load {
  id              String     @id @default(cuid())
  loadNumber      String     @unique // auto-generated by the TMS, e.g. "L-0001"
  referenceNumber String? // customer's own PO / reference number, entered manually
  status          LoadStatus @default(BOOKED)

  pickupAddress   String // full address, e.g. "123 Main St, Chicago, IL 60601"
  deliveryAddress String

  pickupScheduledAt   DateTime
  deliveryScheduledAt DateTime

  pieces    Int?
  weight    Int? // pounds
  commodity String?

  equipment Equipment
  modeType  ModeType

  customerRate Float // what you bill the customer
  carrierRate  Float? // what you pay the carrier (your margin = customerRate - carrierRate)

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  carrier   Carrier? @relation(fields: [carrierId], references: [id])
  carrierId String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
